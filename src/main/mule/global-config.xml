<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="812a388e-8599-423d-8cca-8cfd48fd38fb">
		<http:listener-connection host="0.0.0.0" port="${http.port}" />
	</http:listener-config>
	<configuration-properties doc:name="Configuration properties" doc:id="af4bd0ce-0d25-4481-98c6-4b5be2cfb91e" file="config\dev.yaml" />
	<secure-properties:config name="Secure_Properties_Config" doc:name="Secure Properties Config" doc:id="7d6e8e1a-d242-4d4b-a61f-c9f7a5e2e43a" file="config\secure-dev.yaml" key="abcdef0123456789" />
	<db:config name="Database_Config" doc:name="Database Config" doc:id="c800432b-eaca-4ec3-a53e-b09c933cfb46" >
		<db:my-sql-connection host="${db.host}" port="${db.port}" user="${db.user}" password="${secure::db.password}" database="${db.base}" />
	</db:config>
	<salesforce:sfdc-config name="Salesforce_Config" doc:name="Salesforce Config" doc:id="86245130-806d-4091-bbf6-e9fc04ca61bc" >
		<salesforce:basic-connection username="${sfdc.username}" password="${secure::sfdc.password}" securityToken="${secure::sfdc.token}" url="https://login.salesforce.com/services/Soap/u/64.0"/>
	</salesforce:sfdc-config>
	<configuration doc:name="Configuration" doc:id="2bfbfd50-f296-4a66-a5dc-44fb8ddce89f" defaultErrorHandler-ref="global-error-handler" />
</mule>
